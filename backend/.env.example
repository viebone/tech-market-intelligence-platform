ANTHROPIC_API_KEY=your-api-key-here
GEMINI_API_KEY=your-api-key-here
GEMINI_API_KEY_CLASSIFICATION=your-api-key-here
GEMINI_API_KEY_REQUIREMENTS=your-api-key-here
DATABASE_URL=postgresql://user:password@host:port/dbname
# Job-data sourcing (Greenhouse, Lever, Ashby) needs no credentials — all
# three are public, unauthenticated APIs. Adzuna's ADZUNA_APP_ID/
# ADZUNA_APP_KEY were retired 2026-08-03 (license no longer permits use) —
# see changes/2026-07-28-multi-source-job-data-ingestion.md.

# Pipeline visibility admin dashboard (admin_main.py) — see backend/specs/
# pipeline-visibility/api.md. ADMIN_PASSWORD_HASH is a bcrypt hash, not the
# plaintext password — generate one with (run from backend/src/):
#   python -c "from admin_auth import hash_password; print(hash_password('your-password'))"
# Employment-events ingestion (ingest_employment_events.py) — see
# backend/specs/market-health/api.md — Business Logic — Employment event
# ingestion. Data is fully independent of job-posting data — no company
# matching anywhere in this pipeline (changes/2026-09-11-employment-events-no-company-matching.md).
# UK Companies House Streaming API (all UK insolvency events, no company
# targeting) — free registration at
# https://developer.company-information.service.gov.uk/. Response field
# shape not yet live-verified — see employment_events/companies_house.py.
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key-here
# US WARN notices via WARN Firehose — free tier (25 calls/day), sign up at
# https://www.warnfirehose.com/account. Live-verified 2026-09-11 — real
# data flowing.
WARN_FIREHOSE_API_KEY=your-warn-firehose-api-key-here
# Eurofound ERM needs no key but is not yet wired to a confirmed live
# endpoint — see employment_events/eurofound_erm.py's module docstring.
# SEC EDGAR full-text search — no key at all (free, unauthenticated), but
# SEC's fair-access policy requires a real, descriptive User-Agent
# identifying the caller. Set this to your own org/contact before relying
# on this adapter in production — the fallback in code is dev-only.
SEC_EDGAR_CONTACT=YourOrgName your-real-email@example.com

ADMIN_PASSWORD_HASH=your-bcrypt-hash-here
ADMIN_JWT_SECRET=a-long-random-secret-used-to-sign-admin-session-tokens
# Set to false only for local HTTP dev — the session cookie is Secure
# (HTTPS-only) by default, matching how this service actually runs in
# production (its own Railway domain, HTTPS).
ADMIN_COOKIE_SECURE=true

# Consumer-facing api service (main.py) — see backend/specs/market-health/
# api.md — Tech Decisions. Comma-separated real origin(s) the deployed `web`
# frontend is served from, appended to (never replacing) the hardcoded
# local-dev origin list. Leave unset for local dev — main.py already allows
# localhost/127.0.0.1 without it. Only needed once `web` is actually deployed.
CORS_ALLOWED_ORIGINS=https://your-web-domain.example.com

# Bring-your-own-AI access (mcp_access/) — see backend/specs/mcp-access/api.md.
# Deliberately separate from ADMIN_JWT_SECRET (this product's one-credential-
# per-concern discipline — a leak in one must never forge the other).
USER_JWT_SECRET=a-different-long-random-secret-used-to-sign-consumer-session-tokens
# Same reasoning as ADMIN_COOKIE_SECURE — false only for local HTTP dev.
USER_COOKIE_SECURE=true
# Where the consumer SPA's own /login page lives, for the OAuth consent
# screen's "not signed in yet" redirect. Defaults to the local Vite dev
# server — only needed as a real value once `web` is deployed (not now).
FRONTEND_ORIGIN=http://localhost:5173
# Scraped market-benchmark sources (ingest_scraped_sources.py) — see
# backend/specs/scraped-data-sources/api.md. Required, no fallback
# placeholder — unlike SEC_EDGAR_CONTACT above, ItJobsWatchAdapter *refuses
# to construct* if this is unset or looks like a placeholder
# ("example.com", "set SCRAPER_CONTACT"). This is deliberate: the whole
# reason this adapter is allowed to run at all is a specific, named,
# conditional scraping permission (research/2026-09-16-itjobswatch-scraping-permission.md)
# — running with a placeholder contact would itself violate that condition.
SCRAPER_CONTACT=YourOrgName your-real-email@example.com
# Commercial-mode signal (added 2026-09-16, revised same day) — purely informational, see
# backend/specs/scraped-data-sources/api.md and source_licences.py. Does NOT itself gate
# anything — ingestion never stops regardless, and no source's usability changes automatically
# just because this is "true". It's a reminder, surfaced in the admin Sources & Licensing view,
# to go review source_licences.py's SOURCE_LICENCES and set rejected=True by hand on any source
# that genuinely shouldn't be used once this product is monetized. The only thing that actually
# blocks a source from being used is that per-source `rejected` flag — a deliberate, git-tracked
# human decision, never automatic.
TMIP_COMMERCIAL_MODE=false

# This service's own public URL — used to build the OAuth discovery
# documents at /.well-known/oauth-authorization-server and
# /.well-known/oauth-protected-resource (mcp_access/well_known.py), which a
# connecting MCP client (Claude, ChatGPT, ...) fetches to find the
# register/authorize/token endpoints before it can connect at all. Without
# a correct value here, a real client's first connection attempt fails at
# registration with no other symptom (confirmed against a live Claude
# connector, 2026-09-15 — see changes/2026-09-13-mcp-ai-agent-access.md).
# Defaults to the local backend for local dev; set to the real deployed
# domain (e.g. https://api-production-df13.up.railway.app) once deployed.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Trusted external statistics (ingest_trusted_statistics.py — backend/specs/trusted-statistics/api.md).
# REQUIRED, and must be a real contact: it goes in the User-Agent of every request to a publisher (ONS today).
# The script refuses to run if it is unset or looks like a placeholder — same stance as SCRAPER_CONTACT.
# In production this AND SCRAPER_CONTACT must be set on the Railway `job-sync` service: it runs both scripts daily via
# ingest_periodic.py (a step whose variable is missing is skipped loudly, nothing else is affected). See DEPLOYMENT.md.
STATISTICS_CONTACT=YourOrgName your-real-email@example.com
