ANTHROPIC_API_KEY=your-api-key-here
GEMINI_API_KEY=your-api-key-here
GEMINI_API_KEY_CLASSIFICATION=your-api-key-here
GEMINI_API_KEY_REQUIREMENTS=your-api-key-here
DATABASE_URL=postgresql://user:password@host:port/dbname
# Job-data sourcing (Greenhouse, Lever, Ashby) needs no credentials — all
# three are public, unauthenticated APIs. Adzuna's ADZUNA_APP_ID/
# ADZUNA_APP_KEY were retired 2026-08-03 (license no longer permits use) —
# see changes/2026-07-28-multi-source-job-data-ingestion.md.

# Pipeline visibility admin dashboard (admin_main.py) — see backend/specs/
# pipeline-visibility/api.md. ADMIN_PASSWORD_HASH is a bcrypt hash, not the
# plaintext password — generate one with (run from backend/src/):
#   python -c "from admin_auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here
ADMIN_JWT_SECRET=a-long-random-secret-used-to-sign-admin-session-tokens
# Set to false only for local HTTP dev — the session cookie is Secure
# (HTTPS-only) by default, matching how this service actually runs in
# production (its own Railway domain, HTTPS).
ADMIN_COOKIE_SECURE=true
